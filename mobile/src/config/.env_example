# .env.example - mobile app
#
# Copy this to .env and fill in real values:
#   cp .env.example .env
#
# Note: these are EXPO_PUBLIC_ variables, which means they get compiled
# directly into the app bundle at build time. They are NOT hidden from
# anyone who installs/decompiles the app - this only keeps them out of
# source control, it does not make them a real secret.

# MQTT broker WebSocket URL (wss:// for TLS, ws:// for unencrypted)
EXPO_PUBLIC_BROKER_URL=

# MQTT broker credentials
EXPO_PUBLIC_BROKER_USERNAME=
EXPO_PUBLIC_BROKER_PASSWORD=